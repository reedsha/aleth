# Python virtualenv and bytecode
venv/
__pycache__/
*.py[cod]

# Local secrets
.env

# Runtime workspace output: generated code and task backups are produced by running
# the app, not authored by hand.
my_project_workspace/

# The plan's state database. The roadmap itself (PLAN.md) is tracked on purpose -- it is
# the project's own document, rendered from the store -- but the SQLite database is the
# machine's, and it is never committed.
/deepagents_state.db
/deepagents_state.db-wal
/deepagents_state.db-shm

# Node tooling: Vite and its dependencies
node_modules/

# Vite build output, generated from ui/ by `npm run build` and served by the app
dist/

# Playwright: traces and screenshots of a failed structural test run
test-results/
playwright-report/

# Rust build output for the compiled core (hundreds of MB, rebuilt by maturin)
crates/*/target/

# Editable-install metadata. `uv pip install -e .` writes this beside the project; it is
# regenerated, not authored.
*.egg-info/

# Local knowledge-graph vector index
knowledge_vectors/
